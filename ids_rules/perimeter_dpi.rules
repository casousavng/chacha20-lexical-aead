# ==============================================================================
# Regras Snort/Suricata de referencia para os filtros F1-F3 do artigo.
# NOTA: fornecidas para reproducao por terceiros; NAO foram executadas num
# sensor Suricata/Snort real no artigo (a avaliacao reportada usa os filtros
# stateless equivalentes em Python, ver experimento_pratico_dpi.py).
# ==============================================================================

# F3: watchlist de palavras-chave operacionais em payload UDP/TCP ASCII
alert udp any any -> any any (msg:"WATCHLIST tactical keyword atacar"; content:"atacar"; nocase; sid:1000001; rev:1;)
alert udp any any -> any any (msg:"WATCHLIST tactical keyword evacuar"; content:"evacuar"; nocase; sid:1000002; rev:1;)
alert udp any any -> any any (msg:"WATCHLIST tactical keyword reforcos"; content:"reforcos"; nocase; sid:1000003; rev:1;)
alert udp any any -> any any (msg:"WATCHLIST tactical keyword combustivel"; content:"combustivel"; nocase; sid:1000004; rev:1;)
alert udp any any -> any any (msg:"WATCHLIST tactical keyword recuar"; content:"recuar"; nocase; sid:1000005; rev:1;)
alert udp any any -> any any (msg:"WATCHLIST tactical keyword urgente"; content:"urgente"; nocase; sid:1000006; rev:1;)

# F2: payload predominantemente nao-imprimivel (>=15% de bytes fora de 0x20-0x7E/whitespace)
# Aproximacao Suricata: payload de 64+ bytes que nao corresponde a ASCII imprimivel em 85% dos bytes
alert udp any any -> any any (msg:"BINARY payload non-printable ratio"; dsize:>64; pcre:"/^(?![\x09\x0a\x0d\x20-\x7e]{0,}$)/s"; sid:1000010; rev:1;)

# F1: entropia de byte nao e expressavel em regras Snort nativas; em Suricata requer
# script Lua (detection) que calcule H_b >= 6.8 bits/byte sobre o payload.
